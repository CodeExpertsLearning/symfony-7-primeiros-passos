{% extends 'base.html.twig' %}

{% block title %}Acessar Painel{% endblock %}

{% block body %}
    <div class="w-full h-full absolute flex items-center justify-center">
        <div class="w-[430px] p-8 shadow border border-gray-400 rounded">
            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
                    </div>
                {% endif %}

                <h1 class="text-2xl font-bold mb-3">ACESSAR PAINEL</h1>
                <div class="w-full mb-6">
                    <label for="username">Email</label>
                    <input type="email"
                        value="{{ last_username }}"
                            name="_username"
                            id="username"
                            class="w-full p-2 rounded border border-gray-600 blur:border-gray-900"
                            autocomplete="email" required autofocus>
                </div>

                <div class="w-full mb-6">
                    <label for="password" class="mb-2">Password</label>
                    <input type="password"
                        name="_password"
                        id="password"
                        class="w-full p-2 rounded border border-gray-600 blur:border-gray-900"
                        autocomplete="current-password" required>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                </div>
                {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html

                    <div class="checkbox mb-3">
                        <input type="checkbox" name="_remember_me" id="_remember_me">
                        <label for="_remember_me">Remember me</label>
                    </div>
                #}

                <button class="btn btn-green cursor-pointer" type="submit">
                    ACESSAR
                </button>
            </form>
        </div>
    </div>
{% endblock %}
