<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Painel administrativo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

   {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
   {% endblock %}

   {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
   {% endblock %}
</head>

<body class="min-h-screen">

  <!-- Fundo escuro do menu no mobile -->
  <div id="overlay" class="fixed inset-0 z-30 hidden bg-zinc-950/50 lg:hidden" data-toggle-sidebar></div>

  <!-- ===================== SIDEBAR ===================== -->
  {% include 'includes/sidebar.twig' %}

  <!-- ===================== ÁREA PRINCIPAL ===================== -->
  <div class="lg:pl-sidebar">
  <!-- Header -->
    <header class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-zinc-200 bg-zinc-50/80 px-4 backdrop-blur sm:px-6 dark:border-zinc-800 dark:bg-zinc-950/80">

      <button type="button" class="-ml-1 rounded-lg p-2 text-zinc-600 hover:bg-zinc-200/60 lg:hidden dark:text-zinc-400 dark:hover:bg-zinc-800" data-toggle-sidebar aria-label="Abrir menu">
        <svg class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h10"/></svg>
      </button>

      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="hidden min-w-0 text-sm sm:block">
        <ol class="flex items-center gap-2 text-zinc-500">
          <li><a href="#" class="hover:text-zinc-900 dark:hover:text-white">Início</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-zinc-900 dark:text-white" aria-current="page">Dashboard</li>
        </ol>
      </nav>

      <!-- Busca -->
      <div class="ml-auto hidden w-64 md:block">
        <label class="relative block">
          <span class="sr-only">Buscar</span>
          <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="M20 20l-3.5-3.5"/></svg>
          <input type="search" placeholder="Buscar..." class="w-full rounded-lg border border-zinc-200 bg-white py-1.5 pl-9 pr-3 text-sm placeholder:text-zinc-400 focus:border-brand-500 focus:outline-none dark:border-zinc-800 dark:bg-zinc-900">
        </label>
      </div>

      <!-- Tema -->
      <button type="button" id="theme-toggle" class="ml-auto rounded-lg p-2 text-zinc-600 hover:bg-zinc-200/60 md:ml-0 dark:text-zinc-400 dark:hover:bg-zinc-800" aria-label="Alternar tema">
        <svg class="size-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
        <svg class="hidden size-5 dark:block" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5M17.5 17.5L19 19M5 19l1.5-1.5M17.5 6.5L19 5"/></svg>
      </button>

      <!-- Menu do usuário (com submenu lateral) -->
      <div class="relative" id="user-menu">
        <button type="button" class="flex items-center gap-2 rounded-lg p-1 hover:bg-zinc-200/60 dark:hover:bg-zinc-800" aria-haspopup="true" aria-expanded="false" data-dropdown-btn>
          <span class="grid size-8 place-items-center rounded-full bg-brand-600 text-xs font-semibold text-white">MS</span>
        </button>

        <div class="absolute right-0 mt-2 hidden w-56 rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg dark:border-zinc-800 dark:bg-zinc-900" data-dropdown-panel>
          <a href="#" class="menu-item">Meu perfil</a>
          <a href="#" class="menu-item">Configurações</a>

          <!-- Submenu (2º nível) -->
          <div class="group/sub relative">
            <button type="button" class="menu-item">
              Idioma
              <svg class="size-4 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
            </button>
            <div class="absolute right-full top-0 mr-1 hidden w-44 rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg group-hover/sub:block group-focus-within/sub:block dark:border-zinc-800 dark:bg-zinc-900">
              <a href="#" class="menu-item">Português (BR)</a>
              <a href="#" class="menu-item">English</a>
              <a href="#" class="menu-item">Español</a>
            </div>
          </div>

          <hr class="my-1.5 border-zinc-200 dark:border-zinc-800">
          <a href="#" class="menu-item text-red-600 dark:text-red-400">Sair</a>
        </div>
      </div>
    </header>

    {% block body %}{% endblock %}
  </div>
</body>
</html>
